// QA environment. Values here become build settings; INFOPLIST_KEY_* settings in
// project.yml copy the ones the app reads at runtime into Info.plist.
// Note: "//" starts a comment in xcconfig syntax, so URLs escape it as "\/\/".
APP_NAME = AppTemplate (QA)
APP_BUNDLE_IDENTIFIER = com.yourcompany.apptemplate.qa
BASE_URL = https:\/\/qa-api.example.com
ENV_NAME = QA
