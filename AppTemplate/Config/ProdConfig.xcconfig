// Prod environment. Values here become build settings; project.yml's
// target.info.properties block copies the ones the app reads at runtime into Info.plist.
// Note: "//" starts a comment in xcconfig syntax, so URLs escape it as "\/\/".
APP_NAME = AppTemplate
APP_BUNDLE_IDENTIFIER = com.yourcompany.apptemplate
BASE_URL = https:\/\/api.example.com
ENV_NAME = Prod
